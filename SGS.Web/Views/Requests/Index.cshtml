@model List<SGS.Class.Models.RequestModel>

<h1>Solicitudes</h1>
<a asp-action="Create" class="btn btn-primary mb-3">
    Nueva Solicitud
</a>
<form asp-action="Index" method="get" class="row mb-4">

    <div class="col-md-3">
        <label>Estado</label>
        <select name="status" class="form-control">
            <option value="">Todos</option>

            @foreach (var item in Html.GetEnumSelectList<SGS.Class.Enums.RequestStatus>())
            {
                <option value="@item.Value" selected="@(ViewBag.SelectedStatus != null && item.Value == ((int)ViewBag.SelectedStatus).ToString())">
                    @item.Text
                </option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <label>Prioridad</label>
        <select name="priority" class="form-control">
            <option value="">Todas</option>

            @foreach (var item in Html.GetEnumSelectList<SGS.Class.Enums.RequestPriority>())
            {
                <option value="@item.Value" selected="@(ViewBag.SelectedPriority != null && item.Value == ((int)ViewBag.SelectedPriority).ToString())">
                    @item.Text
                </option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <label>Categoría</label>
        <select name="categoryId" class="form-control">

            <option value="">Todas</option>

            @foreach (var item in ViewBag.Categories as SelectList)
            {
                <option value="@item.Value"
                        selected="@(ViewBag.SelectedCategoryId != null && item.Value == ViewBag.SelectedCategoryId.ToString())">

                    @item.Text

                </option>
            }

        </select>
    </div>

    <div class="col-md-3">
        <label>Responsable</label>
        <select name="assignedUserId" class="form-control">

            <option value="">Todos</option>

            @foreach (var item in ViewBag.Technicians as SelectList)
            {
                <option value="@item.Value"
                        selected="@(ViewBag.SelectedAssignedUserId != null && item.Value == ViewBag.SelectedAssignedUserId.ToString())">

                    @item.Text

                </option>
            }

        </select>
    </div>

    <div class="col-md-12 mt-3">
        <button type="submit" class="btn btn-primary">
            Filtrar
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Limpiar
        </a>
    </div>

</form>
<table class="table">
    <thead>
        <tr>
            <th>Título</th>
            <th>Categoría</th>
            <th>Descripción</th>
            <th>Responsable</th>
            <th>Estado</th>
            <th>Prioridad</th>
            <th>Ubicación</th>
            <th>Fecha</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Category?.Name</td>
                <td>@item.Description</td>
                <td>@(item.AssignedUser != null ? item.AssignedUser.FullName : "Sin asignar")</td>
                <td>
                    @if (item.Status == SGS.Class.Enums.RequestStatus.Pending)
                    {
                        <span class="badge bg-warning text-dark">Pendiente</span>
                    }
                    else if (item.Status == SGS.Class.Enums.RequestStatus.InProgress)
                    {
                        <span class="badge bg-primary">En proceso</span>
                    }
                    else if (item.Status == SGS.Class.Enums.RequestStatus.Completed)
                    {
                        <span class="badge bg-success">Completado</span>
                    }
                </td>

                <td>
                    @if (item.Priority == SGS.Class.Enums.RequestPriority.Low)
                    {
                        <span class="badge bg-secondary">
                            Baja
                        </span>
                    }
                    else if (item.Priority == SGS.Class.Enums.RequestPriority.Medium)
                    {
                        <span class="badge bg-info text-dark">
                            Media
                        </span>
                    }
                    else if (item.Priority == SGS.Class.Enums.RequestPriority.High)
                    {
                        <span class="badge bg-danger">
                            Alta
                        </span>
                    }
                    else if (item.Priority == SGS.Class.Enums.RequestPriority.Urgent)
                    {
                        <span class="badge bg-dark">
                            Urgente
                        </span>
                    }
                </td>

                <td>@item.Location</td>
                <td>@item.CreatedAt</td>

                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">
                        Details
                    </a>

                    @if (User.IsInRole("Admin") || User.IsInRole("Tecnico"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">
                            Edit
                        </a>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">
                            Delete
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>