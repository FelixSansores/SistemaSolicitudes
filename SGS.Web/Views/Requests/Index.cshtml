@model List<SGS.Class.Models.RequestModel>

<h1>Solicitudes</h1>
<a asp-action="Create" class="btn btn-primary mb-3">
    Nueva Solicitud
</a>
<table class="table">
    <thead>
        <tr>
            <th>Título</th>
            <th>Categoría</th>
            <th>Descripción</th>
            <th>Responsable</th>
            <th>Ubicación</th>
            <th>Fecha</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Category?.Name</td>
                <td>@item.Description</td>
                <td>@(item.AssignedUser != null ? item.AssignedUser.Email : "Sin asignar")</td>
                <td>@item.Location</td>
                <td>@item.CreatedAt</td>

                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">
                        Details
                    </a>

                    @if (User.IsInRole("Admin") || User.IsInRole("Tecnico"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">
                            Edit
                        </a>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">
                            Delete
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>