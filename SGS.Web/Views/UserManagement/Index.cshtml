@model List<(SGS.Class.Models.ApplicationUser User, IList<string> Roles)>

<h1>Administración de usuarios</h1>

<a asp-action="CreateUser" class="btn btn-primary mb-3">
    Crear usuario
</a>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Correo</th>
            <th>Roles</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.User.FullName</td>
                <td>@item.User.Email</td>
                <td>@string.Join(", ", item.Roles)</td>
            </tr>
        }
    </tbody>
</table>