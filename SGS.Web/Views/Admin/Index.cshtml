<h1>Panel de Administración</h1>

<div class="row mt-4">

    <div class="col-md-3 mb-3">
        <div class="card text-center p-3">
            <h5>Total Solicitudes</h5>
            <h2>@ViewBag.TotalRequests</h2>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card text-center p-3">
            <h5>Pendientes</h5>
            <h2>@ViewBag.PendingRequests</h2>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card text-center p-3">
            <h5>En Proceso</h5>
            <h2>@ViewBag.InProgressRequests</h2>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card text-center p-3">
            <h5>Completadas</h5>
            <h2>@ViewBag.CompletedRequests</h2>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card text-center p-3">
            <h5>Urgentes</h5>
            <h2>@ViewBag.UrgentRequests</h2>
        </div>
    </div>

</div>

<hr />

<div class="mt-4">

    <a asp-controller="Requests"
       asp-action="Index"
       class="btn btn-primary m-2">
        Solicitudes
    </a>

    <a asp-controller="UserManagement"
       asp-action="Index"
       class="btn btn-success m-2">
        Usuarios
    </a>

</div>