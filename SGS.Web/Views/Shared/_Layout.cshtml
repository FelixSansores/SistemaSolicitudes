<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SGS</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SGS.Web.styles.css" asp-append-version="true" />
</head>

<body class="sgs-body">

    <header>
        <nav class="navbar navbar-expand-lg sgs-navbar">
            <div class="container">

                <a class="navbar-brand sgs-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    SGS<span>.</span>Web
                </a>

                <button class="navbar-toggler bg-light"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav ms-5 me-auto">

                        <li class="nav-item">
                            <a class="nav-link sgs-nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Inicio
                            </a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link sgs-nav-link"
                                   asp-controller="Requests"
                                   asp-action="Index">
                                    Solicitudes
                                </a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link sgs-nav-link"
                                       asp-controller="Admin"
                                       asp-action="Index">
                                        Panel Admin
                                    </a>
                                </li>
                            }
                        }

                    </ul>

                    <ul class="navbar-nav ms-auto">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="nav-link sgs-user">
                                    @User.Identity.Name
                                </span>
                            </li>

                            <li class="nav-item">
                                <a class="btn sgs-btn-outline ms-2"
                                   asp-controller="Auth"
                                   asp-action="Logout">
                                    Cerrar sesión
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link sgs-nav-link"
                                   asp-controller="Auth"
                                   asp-action="Login">
                                    Iniciar sesión
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="btn sgs-btn-primary ms-2"
                                   asp-controller="Auth"
                                   asp-action="Register">
                                    Registrarse
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <main class="sgs-main">
        <div class="container sgs-content">
            @RenderBody()
        </div>
    </main>

    <footer class="sgs-footer">
        <div class="container">
            &copy; 2026 - SGS.Web
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>